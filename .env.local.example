# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. mise auto-loads it via mise.toml [env].

# App Store Connect issuer ID (Users & Access → Keys → top of page)
APP_STORE_CONNECT_ISSUER_ID=

# App Store Connect API key ID (the 10-char ID next to your key)
APP_STORE_CONNECT_KEY_ID=

# Path to the AuthKey_<KEY_ID>.p8 file you downloaded
APP_STORE_CONNECT_PRIVATE_KEY_PATH=
